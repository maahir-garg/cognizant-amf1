# Copy to .env.local. Nothing here is required: with no .env the app runs in
# offline demo mode and serves AI text from data/ai-cache.

# Set to "false" to call the live model (requires GEMINI_API_KEY).
DEMO_MODE=true

# Google Gemini API key (https://aistudio.google.com/apikey). Server-side only.
GEMINI_API_KEY=

# Model id used when DEMO_MODE=false and by `npm run warm-cache`.
AI_MODEL=gemini-2.5-flash
